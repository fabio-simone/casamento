# ─── Supabase ────────────────────────────────────────────────
# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (NUNCA expor no client). Usada nas rotas de servidor/admin.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Mercado Pago ────────────────────────────────────────────
# Painel Mercado Pago > Suas integrações > Credenciais
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# ─── Resend (e-mails transacionais) ──────────────────────────
RESEND_API_KEY=
# Remetente verificado no Resend (ex: casal@kafamento.com.br)
RESEND_FROM_EMAIL=Kafamento <casal@kafamento.com.br>

# ─── Admin ───────────────────────────────────────────────────
# E-mail autorizado a acessar /admin (precisa existir no Supabase Auth)
ADMIN_EMAIL=

# ─── App ─────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXT_PUBLIC_BASE_URL=https://kafamento.com.br
